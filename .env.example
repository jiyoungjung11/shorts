# Claude API — 시나리오 자동 생성 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Vertex AI — 이미지 생성
# https://console.cloud.google.com → 서비스 계정 JSON 다운로드
GOOGLE_SA_KEY_PATH=C:/path/to/service-account.json
GOOGLE_PROJECT_ID=your-gcp-project-id

# Kling API — 영상 생성 (https://klingai.com → Developer)
KLING_ACCESS_KEY=your-access-key
KLING_SECRET_KEY=your-secret-key

# ffmpeg 경로
# Windows: C:\path\to\ffmpeg.exe
# Mac/Linux: ffmpeg  (brew install ffmpeg 또는 apt install ffmpeg)
FFMPEG_PATH=ffmpeg
